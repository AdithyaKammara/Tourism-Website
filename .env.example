# Copy this file to .env and fill in the values from
# Supabase dashboard → Project Settings → API Keys.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Set to true after enabling Google under Authentication → Sign In / Providers.
PUBLIC_GOOGLE_AUTH_ENABLED=false
