---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import WhereToNext from '../components/destinations/WhereToNext';
import { getDestinations, toCard } from '../lib/cards';
import { formatBudget, formatDays, formatSeason } from '../lib/destinations';

const all = await getDestinations();
const featured = all.filter((d) => d.data.featured);
const cards = await Promise.all(all.map(toCard));

// Until we have a hero video, lead with a full-bleed photo from a non-featured place.
const hero = all.find((d) => d.id === 'jaisalmer') ?? all[0];
---

<Layout>
  <section class="relative isolate flex min-h-[88svh] items-end overflow-hidden text-[#fdf8f1]">
    <Image
      src={hero.data.hero}
      alt={hero.data.heroAlt}
      widths={[800, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-10 size-full object-cover"
    />
    <div class="absolute inset-0 -z-10 bg-linear-to-t from-black/75 via-black/25 to-transparent"></div>

    <div class="container-page pt-32 pb-12 md:pb-16">
      <p class="eyebrow mb-6 text-[#fdf8f1]/80">Field notes · India</p>
      <h1 class="font-display text-display max-w-[13ch]">
        Places worth the <em class="text-[#f0a37f]">long way</em> round.
      </h1>
      <div class="mt-10 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <p class="max-w-md text-lg text-[#fdf8f1]/85">
          Honest guides to where to go, when to go and what it really costs. Then a planner that turns it
          into days you can actually follow.
        </p>
        <a
          href="#where-to-next"
          class="self-start rounded-full bg-[#fdf8f1] px-6 py-3 text-sm font-medium text-[#1c1b18] transition-colors hover:bg-[#f0a37f] md:self-auto"
        >
          Find a place for your dates
        </a>
      </div>
      <p class="mt-10 text-xs text-[#fdf8f1]/60">
        {hero.data.name}. Photo:{' '}
        <a href={hero.data.credit.source} class="underline underline-offset-2" rel="noopener">
          {hero.data.credit.author}
        </a>
        , {hero.data.credit.license}
      </p>
    </div>
  </section>

  <section class="container-page py-24 md:py-32" aria-labelledby="season-heading">
    <div class="mb-16 grid gap-6 md:grid-cols-12">
      <p class="eyebrow md:col-span-3">This season</p>
      <h2 id="season-heading" class="font-display text-4xl leading-tight md:col-span-8 md:text-6xl">
        {featured.length} places we keep going back to, and when they're at their best.
      </h2>
    </div>

    <ol class="space-y-24 md:space-y-36">
      {
        featured.map((d, i) => (
          <li class="grid items-center gap-8 md:grid-cols-12 md:gap-12">
            <a
              href={`/destinations/${d.id}`}
              class:list={[
                'group block overflow-hidden md:col-span-7',
                i % 2 === 1 && 'md:order-2 md:col-start-6',
              ]}
              tabindex="-1"
              aria-hidden="true"
            >
              <Image
                src={d.data.hero}
                alt=""
                widths={[640, 960, 1280]}
                sizes="(min-width: 768px) 58vw, 100vw"
                class="aspect-[4/3] w-full object-cover transition-transform duration-700 ease-out-quint group-hover:scale-[1.03]"
              />
            </a>
            <div class:list={['md:col-span-4', i % 2 === 1 ? 'md:order-1 md:col-start-1' : 'md:col-start-9']}>
              <p class="eyebrow">
                {String(i + 1).padStart(2, '0')} · {d.data.state}
              </p>
              <h3 class="mt-4 font-display text-5xl md:text-6xl">
                <a href={`/destinations/${d.id}`} class="hover:text-accent">
                  {d.data.name}
                </a>
              </h3>
              <p class="mt-4 text-lg text-ink-soft">{d.data.tagline}</p>
              <dl class="mt-8 grid grid-cols-3 gap-4 border-t border-line pt-4 text-sm">
                <div>
                  <dt class="eyebrow">Go</dt>
                  <dd class="mt-1">{formatSeason(d.data.bestMonths)}</dd>
                </div>
                <div>
                  <dt class="eyebrow">Stay</dt>
                  <dd class="mt-1">{formatDays(d.data.daysNeeded)}</dd>
                </div>
                <div>
                  <dt class="eyebrow">Spend</dt>
                  <dd class="mt-1">{formatBudget(d.data.budgetPerDay)}</dd>
                </div>
              </dl>
              <p class="mt-6 text-xs text-ink-soft">
                Photo: <a href={d.data.credit.source} class="underline underline-offset-2" rel="noopener">{d.data.credit.author}</a>, {d.data.credit.license}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section id="where-to-next" class="scroll-mt-16 bg-paper-deep py-24 md:py-32" aria-labelledby="next-heading">
    <div class="container-page">
      <div class="mb-12 grid gap-6 md:grid-cols-12">
        <p class="eyebrow md:col-span-3">Where to next?</p>
        <h2 id="next-heading" class="font-display text-4xl leading-tight md:col-span-8 md:text-6xl">
          Tell us when you can travel. We'll tell you <em class="text-accent">where</em>.
        </h2>
      </div>
      <WhereToNext client:visible destinations={cards} />
    </div>
  </section>
</Layout>
