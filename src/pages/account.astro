---
import { ArrowRight, CalendarDays, KeyRound, LogOut, Mail, Map } from 'lucide-react';
import Layout from '../layouts/Layout.astro';

// The middleware redirects guests to /login, so the user is always set here.
const user = Astro.locals.user!;
const name = (user.user_metadata?.full_name as string | undefined) ?? user.email?.split('@')[0] ?? 'traveller';
const joined = new Date(user.created_at).toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
const provider = user.app_metadata?.provider === 'google' ? 'Google' : 'Email';

const facts = [
  { icon: Mail, label: 'Email', value: user.email },
  { icon: KeyRound, label: 'Signs in with', value: provider },
  { icon: CalendarDays, label: 'Member since', value: joined },
];
---

<Layout title="Your account">
  <section class="container-page py-8 md:py-12">
    <div class="grid items-start gap-6 lg:grid-cols-12">
      <div class="rounded-[28px] bg-card p-6 shadow-sm ring-1 ring-line/60 md:p-10 lg:col-span-8">
        <p class="inline-flex items-center gap-1.5 rounded-full bg-sage-soft px-3 py-1 text-xs font-semibold tracking-wider text-moss uppercase">
          <span class="size-1.5 rounded-full bg-accent"></span> Your account
        </p>
        <h1 class="font-heavy mt-4 font-display text-4xl tracking-tight break-words md:text-6xl">
          Hello, <em class="text-accent">{name}</em>.
        </h1>

        <dl class="mt-8 grid gap-3 sm:grid-cols-3">
          {
            facts.map(({ icon: Icon, label, value }) => (
              <div class="rounded-2xl bg-paper-deep p-4">
                <dt class="flex items-center gap-2 text-xs font-semibold text-ink-soft">
                  <Icon className="size-4 text-accent" aria-hidden="true" /> {label}
                </dt>
                <dd class="mt-1 font-semibold break-all">{value}</dd>
              </div>
            ))
          }
        </dl>

        <div class="mt-8 flex flex-wrap gap-2 border-t border-line pt-6">
          {
            provider === 'Email' && (
              <a href="/reset-password" class="btn bg-paper-deep font-semibold hover:bg-sage-soft">
                <KeyRound className="size-4" aria-hidden="true" /> Change password
              </a>
            )
          }
          <form method="post" action="/auth/logout">
            <button type="submit" class="btn font-semibold text-ink-soft hover:bg-paper-deep hover:text-ink">
              <LogOut className="size-4" aria-hidden="true" /> Log out
            </button>
          </form>
        </div>
      </div>

      <div class="relative overflow-clip rounded-[28px] bg-forest p-6 text-cream shadow-soft md:p-8 lg:col-span-4">
        <div class="pointer-events-none absolute -top-10 -right-10 size-48 rounded-full bg-accent/30 blur-3xl"></div>
        <span class="relative grid size-11 place-items-center rounded-full bg-cream/10 text-sage-light">
          <Map className="size-5" aria-hidden="true" />
        </span>
        <h2 class="relative mt-5 font-display text-2xl">Your trips are synced</h2>
        <p class="relative mt-2 text-sm text-cream/70">Trips you plan while signed in are saved to your account, so they follow you to any device.</p>
        <a href="/planner" class="btn relative mt-6 w-full bg-sage-light font-semibold text-forest hover:bg-cream">
          Open trip planner <ArrowRight className="size-4" aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>
</Layout>
