---
import ThemeToggle from './ThemeToggle';
import MobileMenu from './MobileMenu';

const links = [
  { href: '/destinations', label: 'Destinations' },
  { href: '/planner', label: 'Trip planner' },
  { href: '/journal', label: 'Journal' },
];

const path = Astro.url.pathname;
const user = Astro.locals.user;
const account = user
  ? { href: '/account', label: 'Account' }
  : { href: `/login?next=${encodeURIComponent(path)}`, label: 'Log in' };
---

<header class="sticky top-0 z-30 border-b border-line bg-paper/90 backdrop-blur-sm">
  <div class="container-page flex h-16 items-center justify-between gap-6">
    <a href="/" class="font-display text-2xl italic tracking-tight" aria-label="Goadi, home">
      Goadi<span class="text-accent">.</span>
    </a>

    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex items-center gap-8 text-sm">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={path.startsWith(link.href) ? 'page' : undefined}
                class="relative py-1 text-ink-soft transition-colors hover:text-ink aria-[current=page]:text-ink after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:scale-x-0 after:bg-accent after:transition-transform after:duration-500 after:ease-out-quint hover:after:scale-x-100 aria-[current=page]:after:scale-x-100"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <ThemeToggle client:load />
      <a
        href={account.href}
        class="hidden rounded-full bg-ink px-5 py-2.5 text-sm font-medium text-paper transition-colors hover:bg-accent hover:text-accent-ink md:inline-block"
      >
        {account.label}
      </a>
      <MobileMenu client:media="(max-width: 767px)" links={links} account={account} />
    </div>
  </div>
</header>
